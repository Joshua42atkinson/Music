# StepAudio 2.5 Middleware — Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env.

# StepFun API key (from StepFun console)
STEP_API_KEY=your-stepfun-api-key-here

# Supabase project URL
SUPABASE_URL=https://fmaaihxhfgmqdmtmckmc.supabase.co

# Supabase service role key (from Settings → API → service_role key)
# This key bypasses RLS. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server port (default: 8081)
PORT=8081
