# ═══════════════════════════════════════════════════════════
# VOIX VIVE — Environment Variables (Template)
# Copy to .env and fill in your values.
# ═══════════════════════════════════════════════════════════

# Supabase (Persistence + Auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Troubadour AI (Hosted vLLM on GMKtek — primary)
# If set, the app will try this first before falling back to local LM Studio
VITE_TROUBADOUR_API_URL=https://your-gmktek-tunnel-url/v1
VITE_TROUBADOUR_API_KEY=your-secret-api-key

# LM Studio (Local AI fallback — dev only)
VITE_LM_STUDIO_URL=http://localhost:1234
